# Copy to .env if your build pipeline injects process.env.
# These are public OAuth client IDs, not secrets.
#
# Razorpay key_id is returned by the backend when creating a payment order;
# it is never required in the app bundle.

GOOGLE_WEB_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=YOUR_IOS_CLIENT_ID.apps.googleusercontent.com
