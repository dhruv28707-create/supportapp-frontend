// Copy to .env locally and fill in real values.
// Do NOT commit real values to version control.
//
//   RAZORPAY_KEY_ID=<your rzp_live_... or rzp_test_... key_id>
//   GOOGLE_WEB_CLIENT_ID=<your XXXX.apps.googleusercontent.com>
//
// The app loads these from process.env in SRC/secrets.ts.
// On bare React Native, you may need to pass these through your bundler
// or metro config if process.env is not populated automatically.

RAZORPAY_KEY_ID=rzp_placeholder_SET_ME_IN_ENV
GOOGLE_WEB_CLIENT_ID=placeholder_SET_ME_IN_ENV.apps.googleusercontent.com
