{
  "rules": {
    ".read": "auth != null",
    ".write": "auth != null",
    "users": {
      "$uid": {
        ".read": "auth != null && ($uid === auth.uid)",
        ".write": "auth != null && ($uid === auth.uid)",
        "role": {
          ".validate": "newData.val() !== 'developer'"
        },
        "isDeveloper": {
          ".validate": "newData.val() !== true"
        }
      }
    }
  }
}
