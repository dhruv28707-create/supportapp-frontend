rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Admin access is granted only through the `admin` custom claim, which is
    // set server-side via `auth.setCustomUserClaims(uid, { admin: true })`.
    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function isValidUserTier() {
      return request.resource.data.tier in ['free', 'pro', 'ultimate', 'developer'];
    }

    function isValidUserRole() {
      return !('role' in request.resource.data)
        || request.resource.data.role in ['user', 'developer', 'owner'];
    }

    function normalUserCannotSelfPromote() {
      return request.resource.data.tier in ['free', 'pro', 'ultimate']
        && request.resource.data.role != 'developer'
        && request.resource.data.role != 'owner'
        && request.resource.data.isDeveloper != true;
    }

    function normalUserKeepsProtectedFields() {
      // Missing keys on either side must not throw — treat absent == absent.
      // `tier` is always present (enforced by isValidUserTier), the rest are optional.
      return request.resource.data.tier == resource.data.tier
        && (
          !('role' in request.resource.data) || !('role' in resource.data)
          || request.resource.data.role == resource.data.role
        )
        && (
          !('isDeveloper' in request.resource.data) || !('isDeveloper' in resource.data)
          || request.resource.data.isDeveloper == resource.data.isDeveloper
        )
        && (
          !('premium' in request.resource.data) || !('premium' in resource.data)
          || request.resource.data.premium == resource.data.premium
        );
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      allow create: if isAdmin()
        || (
          isOwner(uid)
          && isValidUserTier()
          && isValidUserRole()
          && normalUserCannotSelfPromote()
          && request.resource.data.tier == 'free'
        );

      allow update: if isAdmin()
        || (
          isOwner(uid)
          && isValidUserTier()
          && isValidUserRole()
          && normalUserCannotSelfPromote()
          && normalUserKeepsProtectedFields()
        );

      allow delete: if isAdmin();

      match /chatHistory/{chatId}/messages/{messageId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }

      match /conversations/{conversationId} {
        allow read, write: if isOwner(uid) || isAdmin();

        match /messages/{messageId} {
          allow read, write: if isOwner(uid) || isAdmin();
        }
      }
    }

    match /sessions/{uid} {
      allow read, write: if isOwner(uid) || isAdmin();
    }

    match /payments/{orderId} {
      allow read: if isAdmin() || (signedIn() && resource != null && resource.data.uid == request.auth.uid);
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
